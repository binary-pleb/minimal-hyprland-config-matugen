// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "margin-top": 4,
    "margin-left": 5,
    "margin-right": 5,
    "height": 32,
    "spacing": 4,
    
    "modules-left": [
        "group/pill-left"
    ],
    "modules-center": [
        "group/pill-center"
    ],
    "modules-right": [
        "group/pill-right1",
	"group/pill-right2"
    ],
    
    
    "group/pill-left": {
        "orientation": "horizontal",
        "modules": [
	    "custom/power",
            "hyprland/workspaces"
        ]
    },

    "group/pill-center": {
        "orientation": "horizontal",
        "modules": [
            "clock"
        ]
    },

    "group/pill-right1": {
        "orientation": "horizontal",
        "modules": [
            "network",
	    "pulseaudio"
        ]
    },
   
    "group/pill-right2": {
	"orientation": "horizontal",
	"modules": [
	    "cpu",
	    "memory"
	]
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "hyprland/workspaces": {
	    "persistent-workspaces": {
		    "*": [1, 2, 3, 4, 5]
	    },
	    "persistent-only": false
    },
    "memory": {
        "format": "{}% "
    },
    "cpu": {
        "format": "{usage}%  "
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "custom/power": {
	    "format": "⏻ ",
	    "on-click": "rofi-power-menu",
	    "tooltip": false
    },
    "custom/walls": {
	    "format": "walls ",
	    "on-click": "rofi-wall-switcher",
	    "tooltip": false
    },
    "network": {
        "format-wifi": "{essid}: ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "  ",
        "on-click": "kitty -- nmtui"
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{volume}% {icon}",
        "format-muted": " ",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    } 
}
}
